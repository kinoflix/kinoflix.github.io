rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================================
    // ROL İERARXİYASINI YOXLAYAN KÖMƏKÇİ FUNKSİYALAR
    // ==========================================================================
    
    // Sorğu göndərən istifadəçinin bazadakı rolunu gətirir
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return request.auth != null && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isModerator() {
      return request.auth != null && getUserRole() == 'moderator';
    }

    // Mesajı göndərən şəxsin rolunu yoxlamaq üçün funksiya
    function getSenderRole(senderId) {
      return get(/databases/$(database)/documents/users/$(senderId)).data.role;
    }

    // ==========================================================================
    // ŞƏBƏKƏ VƏ IP/CİHAZ BAN SİSTEMİ (`blacklist` və `user_network`)
    // ==========================================================================
    match /blacklist/{docId} {
      // Hər kəs oxuya bilər ki, giriş edərkən sistem onları yoxlaya bilsin
      allow read: if true;
      // Yalnız Super Admin qara siyahıya IP/Cihaz əlavə edə bilər
      allow write: if isSuperAdmin();
    }

    match /user_network/{userId} {
      // Super Admin hamının IP datasını görə bilər, istifadəçi isə yalnız özünü oxuya bilər
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      // İstifadəçi ancaq öz profilinə (UID) uyğun IP/Cihaz məlumatını yaza bilər
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================================================
    // İSTİFADƏÇİ PROFİLLƏRİ (`users` kolleksiyası)
    // ==========================================================================
    match /users/{userId} {
      // Çatda olan hər kəs istifadəçi siyahısını və rolları canlı görə bilməlidir
      allow read: if true;
      
      // 1. YENİ QEYDİYYAT (Create): 
      // Adi istifadəçi qeydiyyatdan keçəndə öz rolunu yalnız 'user' edə bilər. 
      // Super Admin isə birbaşa sistem daxilindən fərqli rola sahib hesab yarada bilər.
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == 'user') 
        || isSuperAdmin()
      );
      
      // 2. PROFİL YENİLƏMƏ (Update):
      // Rol dəyişdirmə, Banlama və Profil Redaktəsi məntiqlərinin qorunması.
      allow update: if request.auth != null && (
        // A) İstifadəçi öz profilini yeniləyir: Amma öz rolunu ('role') və ban statusunu ('isBanned') DEYİŞƏ BİLMƏZ!
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned']))
        
        // B) Super Admin: Hər şeyi edə bilər (İstənilən şəxsə rol verə/ala və istənilən şəxsi banlaya bilər)
        || isSuperAdmin()
        
        // C) Admin: Yalnız moderator və user-lərin ban statusunu dəyişə bilər. Rol ('role') sahəsinə toxuna bilməz!
        || (isAdmin() 
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) 
            && (resource.data.role == 'moderator' || resource.data.role == 'user'))
      );
      
      // 3. HESABLARIN SİLİNMƏSİ (Delete):
      // Tələbə uyğun olaraq: İstifadəçi öz hesabını silə bilər, Super Admin isə hər kəsin hesabını silə bilər. Admin silə bilməz.
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // ==========================================================================
    // İGNOR SİYAHILARI (`ignore_lists` kolleksiyası)
    // ==========================================================================
    match /ignore_lists/{userId} {
      // Hər bir daxil olmuş istifadəçi yalnız və yalnız öz ignor siyahısını oxuya və yaza bilər
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================================================
    // OTAQLAR VƏ MESAJLAŞMA (`rooms` kolleksiyası)
    // ==========================================================================
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
      
      // SÖHBƏT MESAJLARI (Alt kolleksiya)
      match /messages/{messageId} {
        allow read: if request.auth != null;
        
        // --- TƏHLÜKƏSİZLİK ƏLAVƏSİ ---
        // 1. Mesaj yazarkən kimsə başqasının adından mesaj göndərə bilməz.
        // 2. 'exists' yoxlaması ilə silinmiş hesabların mesaj yazmasının qarşısı alınır.
        allow create: if request.auth != null && 
                      request.resource.data.senderId == request.auth.uid &&
                      exists(/databases/$(database)/documents/users/$(request.auth.uid));
        
        // MESAJIN SİLİNMƏSİ İERARXİYASI:
        allow delete: if request.auth != null && (
          // A) Mesajın sahibi öz mesajını hər zaman silə bilər
          resource.data.senderId == request.auth.uid
          
          // B) Super Admin bütün mesajları silə bilər
          || isSuperAdmin()
          
          // C) Admin yalnız moderator və user-lərin mesajlarını silə bilər
          || (isAdmin() && (getSenderRole(resource.data.senderId) == 'moderator' || getSenderRole(resource.data.senderId) == 'user'))
          
          // D) Moderator yalnız adi user-lərin mesajlarını silə bilər
          || (isModerator() && getSenderRole(resource.data.senderId) == 'user')
        );
        
        // Göndərilmiş mesajların tərkibinin redaktəsinə icazə verilmir
        allow update: if false;
      }
    }
  }
}
